type nums is array [3] integer;

routine total(a : array [] integer) : integer is
	var s : integer is 0;
	for v in a loop
		s := s + v;
	end
	return s;
end

routine main() is
	var xs : nums;
	var s : integer is total(xs);
	var s : integer is 1;
	for i in 1 .. 3 loop
		i := 5;
	end
	xs.size := 4;
	print undefined_name;
	print s;
end
